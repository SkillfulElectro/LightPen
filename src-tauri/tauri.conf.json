{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightPen",
  "version": "0.1.4",
  "identifier": "app.lightpen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LightPen",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["default", "desktop", "mobile"]
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "app", "dmg"],
    "createUpdaterArtifacts": false,
    "publisher": "ElectroMutex",
    "copyright": "MIT \u00a9 ElectroMutex",
    "category": "Productivity",
    "shortDescription": "Write on PDFs in the air",
    "longDescription": "LightPen lets you open a PDF, turn on your camera and write on it in the air with your hand. All processing happens on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-pipewire"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good", "pipewire-gstreamer"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "description": "PDF document",
        "role": "Editor"
      }
    ]
  }
}
